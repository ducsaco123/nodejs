<!DOCTYPE html>
<html lang="vi">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Chi tiết laptop tại Laptopshop" />
    <title><%= product.name %> | Laptopshop</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://use.fontawesome.com/releases/v5.15.4/css/all.css" />
    <link href="/client/css/bootstrap.min.css" rel="stylesheet" />
    <link href="/client/css/style.css" rel="stylesheet" />
    <link href="/client/css/modern.css" rel="stylesheet" />
  </head>
  <body class="storefront">
    <%- include('../layout/header') -%>
    <main class="detail-page">
      <div class="container">
        <nav class="detail-breadcrumb" aria-label="Đường dẫn trang"><a href="/">Trang chủ</a><i class="fas fa-chevron-right"></i><a href="/#san-pham">Sản phẩm</a><i class="fas fa-chevron-right"></i><span><%= product.name %></span></nav>
        <div class="row g-5 align-items-center">
          <div class="col-lg-6"><div class="detail-image-panel"><span class="detail-image-label">LAPTOPSHOP COLLECTION</span><img src="/images/product/<%= product.image %>" alt="<%= product.name %>" /><span class="detail-image-corner"><i class="fas fa-laptop"></i></span></div></div>
          <div class="col-lg-6">
            <div class="detail-info">
              <span class="section-kicker"><%= product.factory %> · LAPTOP</span>
              <h1><%= product.name %></h1>
              <p class="detail-lead"><%= product.shortDesc %></p>
              <div class="detail-price"><small>Giá sản phẩm</small><strong><%= new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(product.price) %></strong></div>
              <div class="detail-meta"><span><i class="fas fa-tag"></i> <%= product.factory %></span><span><i class="fas fa-info-circle"></i> Thông tin chi tiết bên dưới</span></div>
              <a href="/#san-pham" class="btn detail-back-button"><i class="fas fa-arrow-left me-2"></i> Xem thêm sản phẩm</a>
            </div>
          </div>
        </div>
        <section class="detail-description"><span class="section-kicker">THÔNG TIN SẢN PHẨM</span><h2>Chi tiết sản phẩm</h2><p><%= product.detailDesc %></p></section>
      </div>
    </main>
    <%- include('../layout/footer') -%>
    <a href="#" class="back-to-top" aria-label="Lên đầu trang"><i class="fas fa-arrow-up"></i></a>
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.6.4/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/client/lib/easing/easing.min.js"></script>
    <script src="/client/lib/owlcarousel/owl.carousel.min.js"></script>
    <script src="/client/js/main.js"></script>
  </body>
</html>
