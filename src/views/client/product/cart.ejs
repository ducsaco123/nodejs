<!DOCTYPE html>
<html lang="vi">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Giỏ hàng | Laptopshop</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@500;600;700;800&display=swap"
      rel="stylesheet"
    />
    <link
      rel="stylesheet"
      href="https://use.fontawesome.com/releases/v5.15.4/css/all.css"
    />
    <link href="/client/css/bootstrap.min.css" rel="stylesheet" />
    <link href="/client/css/style.css" rel="stylesheet" />
    <link href="/client/css/modern.css" rel="stylesheet" />
  </head>
  <body class="storefront cart-page">
    <%- include('../layout/header') -%>

    <main class="cart-main">
      <div class="container">
        <!-- Breadcrumb -->
        <nav class="detail-breadcrumb" aria-label="Đường dẫn trang">
          <a href="/">Trang chủ</a>
          <i class="fas fa-chevron-right"></i>
          <span>Giỏ hàng</span>
        </nav>

        <!-- Tiêu đề trang -->
        <div class="cart-heading">
          <span class="section-kicker">GIỎ HÀNG CỦA BẠN</span>
          <h1>Chi tiết giỏ hàng</h1>
          <p>Xem lại danh sách sản phẩm và tiến hành đặt hàng.</p>
        </div>

        <div class="row g-4 align-items-start">
          <!-- Bảng danh sách sản phẩm -->
          <div class="col-lg-8">
            <div class="cart-table-card">
              <div class="table-responsive">
                <table class="table cart-table align-middle">
                  <thead>
                    <tr>
                      <th scope="col" class="cart-th-product">Sản phẩm</th>
                      <th scope="col" class="cart-th-price">Đơn giá</th>
                      <th scope="col" class="cart-th-quantity text-center">Số lượng</th>
                      <th scope="col" class="cart-th-total text-end">Thành tiền</th>
                      <th scope="col" class="cart-th-action text-center">Xóa</th>
                    </tr>
                  </thead>
                  <tbody>
                    <!-- Dữ liệu mẫu (HTML mẫu để bạn dễ dàng lồng ghép vòng lặp EJS) -->
                    <tr>
                      <td>
                        <div class="cart-product-cell">
                          <a href="/product/1" class="cart-product-img">
                            <img
                              src="/images/product/1711079954090-apple-01.png"
                              alt="Apple MacBook Air M2"
                            />
                          </a>
                          <div class="cart-product-info">
                            <span class="cart-product-brand">APPLE</span>
                            <a href="/product/1" class="cart-product-title"
                              >Apple MacBook Air M2 (2023)</a
                            >
                            <small class="cart-product-meta">Màu: Midnight · 256GB</small>
                          </div>
                        </div>
                      </td>
                      <td class="cart-price">27.990.000 ₫</td>
                      <td>
                        <div class="cart-quantity-stepper mx-auto">
                          <button
                            class="cart-stepper-btn btn-minus"
                            type="button"
                            aria-label="Giảm số lượng"
                          >
                            <i class="fas fa-minus"></i>
                          </button>
                          <input
                            type="number"
                            class="cart-stepper-input"
                            value="1"
                            min="1"
                            max="99"
                            aria-label="Số lượng"
                          />
                          <button
                            class="cart-stepper-btn btn-plus"
                            type="button"
                            aria-label="Tăng số lượng"
                          >
                            <i class="fas fa-plus"></i>
                          </button>
                        </div>
                      </td>
                      <td class="cart-total text-end">27.990.000 ₫</td>
                      <td class="text-center">
                        <button
                          class="cart-remove-btn"
                          type="button"
                          aria-label="Xóa sản phẩm khỏi giỏ hàng"
                          title="Xóa sản phẩm"
                        >
                          <i class="fas fa-trash-alt"></i>
                        </button>
                      </td>
                    </tr>
                    <tr>
                      <td>
                        <div class="cart-product-cell">
                          <a href="/product/2" class="cart-product-img">
                            <img
                              src="/images/product/1711079496409-asus-02.png"
                              alt="Asus TUF Gaming F15"
                            />
                          </a>
                          <div class="cart-product-info">
                            <span class="cart-product-brand">ASUS</span>
                            <a href="/product/2" class="cart-product-title"
                              >Asus TUF Gaming F15 FX506HF</a
                            >
                            <small class="cart-product-meta">Màu: Black · 512GB</small>
                          </div>
                        </div>
                      </td>
                      <td class="cart-price">19.500.000 ₫</td>
                      <td>
                        <div class="cart-quantity-stepper mx-auto">
                          <button
                            class="cart-stepper-btn btn-minus"
                            type="button"
                            aria-label="Giảm số lượng"
                          >
                            <i class="fas fa-minus"></i>
                          </button>
                          <input
                            type="number"
                            class="cart-stepper-input"
                            value="1"
                            min="1"
                            max="99"
                            aria-label="Số lượng"
                          />
                          <button
                            class="cart-stepper-btn btn-plus"
                            type="button"
                            aria-label="Tăng số lượng"
                          >
                            <i class="fas fa-plus"></i>
                          </button>
                        </div>
                      </td>
                      <td class="cart-total text-end">19.500.000 ₫</td>
                      <td class="text-center">
                        <button
                          class="cart-remove-btn"
                          type="button"
                          aria-label="Xóa sản phẩm khỏi giỏ hàng"
                          title="Xóa sản phẩm"
                        >
                          <i class="fas fa-trash-alt"></i>
                        </button>
                      </td>
                    </tr>
                  </tbody>
                </table>
              </div>
              <div class="cart-table-footer">
                <a href="/#san-pham" class="cart-back-shop">
                  <i class="fas fa-arrow-left me-2"></i> Tiếp tục chọn sản phẩm
                </a>
              </div>
            </div>
          </div>

          <!-- Phần Checkout / Tóm tắt đơn hàng -->
          <div class="col-lg-4">
            <div class="cart-summary-card">
              <h2 class="cart-summary-title">Tóm tắt đơn hàng</h2>

              <div class="cart-summary-row">
                <span>Tạm tính</span>
                <strong>47.490.000 ₫</strong>
              </div>

              <div class="cart-summary-row">
                <span>Phí vận chuyển</span>
                <span class="cart-shipping-free">Miễn phí</span>
              </div>

              <div class="cart-summary-divider"></div>

              <div class="cart-summary-total">
                <div class="cart-total-label">
                  <span>Tổng thanh toán</span>
                  <small>Đã bao gồm VAT</small>
                </div>
                <strong class="cart-total-price">47.490.000 ₫</strong>
              </div>

              <a href="/checkout" class="cart-checkout-btn">
                <span>Tiến hành thanh toán</span>
                <i class="fas fa-arrow-right"></i>
              </a>

              <div class="cart-summary-security">
                <i class="fas fa-shield-alt"></i>
                <span>Giao dịch an toàn & bảo mật 100%</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </main>

    <%- include('../layout/footer') -%>

    <a href="#" class="back-to-top" aria-label="Lên đầu trang"
      ><i class="fas fa-arrow-up"></i
    ></a>

    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.6.4/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
      document.querySelectorAll('.cart-quantity-stepper').forEach((stepper) => {
        const input = stepper.querySelector('.cart-stepper-input');
        const btnMinus = stepper.querySelector('.btn-minus');
        const btnPlus = stepper.querySelector('.btn-plus');

        if (btnMinus && input) {
          btnMinus.addEventListener('click', () => {
            const current = parseInt(input.value, 10) || 1;
            if (current > 1) {
              input.value = current - 1;
              input.dispatchEvent(new Event('change', { bubbles: true }));
            }
          });
        }

        if (btnPlus && input) {
          btnPlus.addEventListener('click', () => {
            const current = parseInt(input.value, 10) || 1;
            if (current < 99) {
              input.value = current + 1;
              input.dispatchEvent(new Event('change', { bubbles: true }));
            }
          });
        }
      });
    </script>
  </body>
</html>
