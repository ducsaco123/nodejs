<!DOCTYPE html>
<html lang="vi">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Khám phá laptop tại Laptopshop" />
    <title>Laptopshop | Khám phá laptop phù hợp với bạn</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://use.fontawesome.com/releases/v5.15.4/css/all.css" />
    <link href="/client/css/bootstrap.min.css" rel="stylesheet" />
    <link href="/client/css/style.css" rel="stylesheet" />
    <link href="/client/css/modern.css" rel="stylesheet" />
  </head>
  <body class="storefront">
    <%- include('../layout/header') -%>
    <main>
      <%- include('../layout/banner') -%>
      <%- include('../layout/feature') -%>
      <section class="catalog-section" id="san-pham">
        <div class="container">
          <div class="catalog-heading">
            <div><span class="section-kicker">KHÁM PHÁ BỘ SƯU TẬP</span><h2>Laptop nổi bật</h2><p>Chọn chiếc máy phù hợp với công việc và phong cách của bạn.</p></div>
            <span class="catalog-count"><%= products.length %> sản phẩm</span>
          </div>
          <div class="row g-4">
            <% products.forEach((product) => { %>
              <div class="col-sm-6 col-lg-4 col-xl-3">
                <article class="product-card">
                  <a class="product-image" href="/product/<%= product.id %>" aria-label="Xem chi tiết <%= product.name %>">
                    <span class="product-chip">Laptop</span>
                    <img src="/images/product/<%= product.image %>" alt="<%= product.name %>" loading="lazy" />
                  </a>
                  <div class="product-card-body">
                    <span class="product-eyebrow"><%= product.factory %></span>
                    <h3><a href="/product/<%= product.id %>"><%= product.name %></a></h3>
                    <p class="product-description"><%= product.shortDesc %></p>
                    <div class="product-card-bottom">
                      <div class="product-price-box">
                        <strong class="product-price"><%= new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(product.price) %></strong>
                      </div>
                      <form action="/add-product-to-cart/<%= product.id %>" method="post" class="product-cart-form">
                        <button type="submit" class="product-add-cart" aria-label="Thêm <%= product.name %> vào giỏ hàng" title="Thêm vào giỏ hàng">
                          <i class="fas fa-cart-plus" aria-hidden="true"></i>
                          <span>Add to cart</span>
                        </button>
                      </form>
                    </div>
                  </div>
                </article>
              </div>
            <% }); %>
          </div>
          <% if (!products.length) { %><div class="catalog-empty"><i class="fas fa-laptop"></i><h3>Chưa có sản phẩm</h3><p>Danh sách laptop sẽ được cập nhật tại đây.</p></div><% } %>
        </div>
      </section>
    </main>
    <%- include('../layout/footer') -%>
    <a href="#" class="back-to-top" aria-label="Lên đầu trang"><i class="fas fa-arrow-up"></i></a>
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.6.4/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/client/lib/easing/easing.min.js"></script>
    <script src="/client/lib/owlcarousel/owl.carousel.min.js"></script>
    <script src="/client/js/main.js"></script>
  </body>
</html>
